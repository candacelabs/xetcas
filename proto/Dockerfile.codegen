FROM golang:1.26.5-bookworm@sha256:6c5605ab3a9a9fb3c4eafe5b3d63cdbf3881caf113262b67862547b54a9db599

ARG PROTOC_VERSION=35.1
ARG PROTOC_LINUX_X86_64_SHA256=6930ebf62bd4ea607b98fff052596c6ee564b9835b4ce172c75a3f53ae9d91b7
# candacelib pin: export tag published from candace-server main 4bbae8aa.
ARG CANDACELIB_VERSION=export-4bbae8aa45d6

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" \
    && echo "${PROTOC_LINUX_X86_64_SHA256}  /tmp/protoc.zip" | sha256sum -c - \
    && unzip -q /tmp/protoc.zip -d /usr/local bin/protoc 'include/*' \
    && rm /tmp/protoc.zip \
    && chmod 0755 /usr/local/bin/protoc

RUN GOTOOLCHAIN=local go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.11 \
    && GOTOOLCHAIN=local go install \
      "github.com/candacelabs/candacelib/cmd/protoc-gen-liquidproto@${CANDACELIB_VERSION}"

# Stage the pinned candacelib module so liquidproto/v1/refinement.proto is on
# the protoc include path without network access at generation time.
RUN set -eu; \
    scratch="$(mktemp -d)"; \
    cd "${scratch}"; \
    GOTOOLCHAIN=local go mod init codegen-scratch >/dev/null; \
    GOTOOLCHAIN=local go get "github.com/candacelabs/candacelib@${CANDACELIB_VERSION}"; \
    dir="$(GOTOOLCHAIN=local go list -m -f '{{.Dir}}' github.com/candacelabs/candacelib)"; \
    cp -r "${dir}" /opt/candacelib; \
    chmod -R a+rX /opt/candacelib; \
    rm -rf "${scratch}"

ENV GOTOOLCHAIN=local
ENV PATH="/go/bin:${PATH}"

WORKDIR /workspace
